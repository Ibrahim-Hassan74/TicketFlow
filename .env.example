# ============================================================
# TicketFlow Docker & Environment Configuration Template
# ============================================================
# Instructions:
# 1. Copy this template to '.env':
#      cp .env.example .env
# 2. Adjust secrets and connection settings as needed.
# 3. NEVER commit your actual '.env' to git repository!
# ============================================================

# --- ASP.NET Core Runtime ---
ASPNETCORE_ENVIRONMENT=Production
API_HTTP_PORT=5000

# --- PostgreSQL Container Database ---
POSTGRES_PORT=5432
POSTGRES_DB=ticketflow_db
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=YourStrong@PostgresPass123

# --- Database Connection String Override (Optional) ---
# If left commented or unset, docker-compose defaults to the local 'postgres' container.
# If connecting to an external or remote PostgreSQL server, uncomment and configure:
# CONNECTION_STRING=Server=db73588.public.databaseasp.net;Port=5432;Database=db73588;User Id=db73588;Password=G-q58J!w@2sT;

# --- JWT Authentication ---
# NOTE: The key below is an EXAMPLE secret for local development/testing only.
# In production, generate a secure random 256-bit base64 key and set it in your .env:
# (e.g. openssl rand -base64 64)
JWT_KEY=V9AUi93Un0mh8hpNj/dC19I83Eu9xZLdsvDNKbniS1bRnQaVuKb+1vRRd03l1k0HQ5mjab0sHHdmEnYmD3pWgQ==
JWT_ISSUER=https://ticket-flow.api
JWT_AUDIENCE_0=https://localhost:4200
JWT_AUDIENCE_1=postman-client
JWT_EXPIRATION_MINUTES=30

# --- Refresh Token Expiration (Minutes) ---
REFRESH_TOKEN_EXPIRATION_MINUTES=500
REFRESH_TOKEN_LONG_EXPIRATION_MINUTES=2880

# --- CORS Allowed Origins ---
ALLOWED_ORIGIN_0=https://ticket--hub.web.app
ALLOWED_ORIGIN_1=https://localhost:4200
